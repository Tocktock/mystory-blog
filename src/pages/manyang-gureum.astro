---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/common/EmptyState.astro';
import CatGallery from '../components/cats/CatGallery.astro';
import CatProfileCard from '../components/cats/CatProfileCard.astro';
import EntryList from '../components/observatory/EntryList.astro';
import EntryRow from '../components/observatory/EntryRow.astro';
import PageHero from '../components/observatory/PageHero.astro';
import SectionHead from '../components/observatory/SectionHead.astro';
import TextLink from '../components/observatory/TextLink.astro';
import { SITE_TITLE } from '../consts';
import { cats } from '../data/cats';
import { catPhotos } from '../data/catGallery';
import { uiCopy } from '../data/uiCopy';
import { routes } from '../utils/routes';

const PAGE_TITLE = `만냥구름 | ${SITE_TITLE}`;
const PAGE_DESCRIPTION =
  '같이 사는 고양이 만냥이와 구름이 이야기예요. 사진과 함께, 둘을 돌보며 알게 된 것들을 적어요.';

const featuredPhoto = catPhotos.find((photo) => photo.featured) ?? catPhotos[0];
const observationNotes = [
  {
    title: '먼저 바라보기',
    description: '바로 혼내기보다 자주 보이는 표정, 자리, 움직임을 먼저 봐요.',
  },
  {
    title: '원인을 이해하기',
    description: '이상한 행동에도 이유가 있다고 보고, 주변 환경부터 살펴요.',
  },
  {
    title: '적어 두기',
    description: '효과가 있었던 방법과 좋았던 순간을 적어 두고 다음에 참고해요.',
  },
] as const;

const observationPosts = (await getCollection('blog'))
  .filter((post) => post.data.category === 'cats')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<SiteLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  lang="ko"
  mainLabelledBy="manyang-gureum-title"
>
  <div class="manyang-page">
    <PageHero
      kicker="PERSONAL / MANYANG & GUREUM"
      title="만냥구름"
      titleId="manyang-gureum-title"
      lede="같이 사는 고양이 만냥이와 구름이예요. 귀여운 사진도 모으고, 둘을 돌보면서 알게 된 것들도 적어 둬요."
    >
      <nav class="manyang-hero__actions" aria-label="만냥구름 페이지 섹션 이동">
        <TextLink href="#cat-profiles">둘 소개 보기</TextLink>
        <TextLink href="#cat-gallery">사진첩 보기</TextLink>
        <TextLink href="#cat-notes">관찰일지 보기</TextLink>
      </nav>
    </PageHero>

    <div class="shell manyang-page__body">
      <section
        class="observation-bridge"
        aria-labelledby="observation-bridge-title"
        id="observation-bridge"
      >
        <SectionHead
          kicker="01 / CARE"
          title="돌보면서 배운 것"
          titleId="observation-bridge-title"
        />

        <div class="observation-bridge__stage">
          {
            featuredPhoto && (
              <figure class="manyang-hero__photo">
                <Image
                  src={featuredPhoto.image}
                  alt={featuredPhoto.alt}
                  widths={[420, 640, 820, 960]}
                  sizes="(max-width: 860px) calc(100vw - 48px), 460px"
                  loading="eager"
                  decoding="async"
                />
                <figcaption class="meta">{featuredPhoto.caption}</figcaption>
              </figure>
            )
          }
          <p class="observation-bridge__intro">
            둘을 키우면서, 행동만 보고 판단하기 전에 이유부터 살피는 습관이 생겼어요.
          </p>
        </div>

        <ol class="observation-bridge__grid">
          {
            observationNotes.map((note, index) => (
              <li>
                <span class="meta">{String(index + 1).padStart(2, '0')}</span>
                <article>
                  <h3>{note.title}</h3>
                  <p>{note.description}</p>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="cat-profiles" class="cat-profiles" aria-labelledby="cat-profiles-title">
        <SectionHead kicker="02 / PROFILES" title="만냥이와 구름이" titleId="cat-profiles-title" />
        <div class="cat-profiles__grid">
          {cats.map((cat) => <CatProfileCard cat={cat} />)}
        </div>
      </section>

      <div id="cat-gallery" class="manyang-page__gallery">
        <CatGallery photos={catPhotos} kicker="03 / PHOTOS" />
      </div>

      <section id="cat-notes" class="cat-notes" aria-labelledby="cat-notes-title">
        <SectionHead kicker="04 / NOTES" title="만냥구름 관찰일지" titleId="cat-notes-title" />

        {
          observationPosts.length > 0 ? (
            <EntryList>
              {observationPosts.map((post) => (
                <EntryRow
                  class="cat-notes__item"
                  href={routes.record(post.id)}
                  title={post.data.title}
                  date={post.data.pubDate}
                >
                  <p class="cat-notes__description">{post.data.description}</p>
                </EntryRow>
              ))}
            </EntryList>
          ) : (
            <EmptyState
              eyebrow={uiCopy.emptyLabel}
              title={uiCopy.emptyTitle}
              description="아직 관찰일지에 쓴 글이 없어요. 먼저 사진첩을 구경해 보세요."
              href={routes.records}
              linkLabel="다른 글 보기"
              compact
            />
          )
        }
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .manyang-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2.25rem;
  }

  .manyang-page__body {
    display: grid;
    gap: clamp(100px, 12vw, 160px);
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .manyang-page__body > * {
    scroll-margin-top: 1.5rem;
  }

  .observation-bridge__stage {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
    padding: clamp(40px, 6vw, 70px) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .manyang-hero__photo {
    margin: 0;
  }

  .manyang-hero__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .manyang-hero__photo figcaption {
    margin-top: 0.9rem;
  }

  .observation-bridge__intro {
    max-width: 620px;
    margin: 0;
    color: var(--fg);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1.85;
    word-break: keep-all;
  }

  .observation-bridge__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .observation-bridge__grid li {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 40px;
    padding: 38px 0;
    border-bottom: 1px solid var(--line);
  }

  .observation-bridge__grid h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.5;
  }

  .observation-bridge__grid p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    line-height: 1.9;
    word-break: keep-all;
  }

  .cat-profiles__grid {
    border-top: 1px solid var(--line);
  }

  .cat-notes__description {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  @media (max-width: 860px) {
    .observation-bridge__stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .observation-bridge__grid li {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 28px 0;
    }
  }
</style>
