---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EntryList from '../../components/observatory/EntryList.astro';
import PageHero from '../../components/observatory/PageHero.astro';
import RecordCard from '../../components/records/RecordCard.astro';
import RecordFilters from '../../components/records/RecordFilters.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { categoryList, type Category } from '../../data/categories';
import { routes } from '../../utils/routes';

type Props = {
  category: Category;
  posts: CollectionEntry<'blog'>[];
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return categoryList
    .map((category) => ({
      category,
      posts: posts
        .filter((post) => post.data.category === category.slug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    }))
    .filter(({ posts }) => posts.length > 0)
    .map(({ category, posts }) => ({
      params: { slug: category.slug },
      props: { category, posts },
    }));
}

const { category, posts } = Astro.props as Props;
const allPosts = await getCollection('blog');
const activeCategories = categoryList.filter((candidate) =>
  allPosts.some((post) => post.data.category === candidate.slug),
);
---

<SiteLayout
  title={`${category.label} 기록 | ${SITE_TITLE}`}
  description={category.description}
  lang="ko"
  mainLabelledBy="category-title"
>
  <div class="category-page">
    <PageHero
      kicker={`CATEGORY / ${category.slug.toUpperCase()}`}
      title={category.label}
      titleId="category-title"
      lede={category.description}
    >
      <p class="meta category-page__breadcrumbs" slot="top">
        <a href={routes.records}>기록</a>
        <span aria-hidden="true">/</span>
        <span>{category.label}</span>
      </p>
    </PageHero>

    <section class="shell category-page__content" aria-label={`${category.label} 기록 목록`}>
      <RecordFilters categories={activeCategories} activeSlug={category.slug} />
      <p class="kicker category-page__count">{posts.length} POSTS</p>
      <EntryList>
        {
          posts.map((post, index) => (
            <RecordCard post={post} index={index + 1} showCategory={false} showTags={false} />
          ))
        }
      </EntryList>
    </section>
  </div>
</SiteLayout>

<style>
  .category-page__breadcrumbs {
    margin: 0;
  }

  .category-page__breadcrumbs a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .category-page__breadcrumbs span[aria-hidden] {
    margin: 0 0.6em;
  }

  .category-page__count {
    margin: 0.5rem 0 1.5rem;
  }

  .category-page__content {
    padding-bottom: clamp(120px, 14vw, 220px);
  }
</style>
