---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import CreationCard from '../components/creations/CreationCard.astro';
import PageHero from '../components/observatory/PageHero.astro';
import SectionHead from '../components/observatory/SectionHead.astro';
import TextLink from '../components/observatory/TextLink.astro';
import { SITE_TITLE } from '../consts';
import { creations, YOUTUBE_CHANNEL_URL } from '../data/creations';

const featured = creations.find((creation) => creation.featured) ?? creations[0];
const archive = creations.filter((creation) => creation.slug !== featured?.slug);
const PAGE_TITLE = `창작 | ${SITE_TITLE}`;
const PAGE_DESCRIPTION =
  'AI를 악기처럼 사용해 만든 음악과 가사 영상, 그리고 결과물 뒤의 선택과 실험을 모았습니다.';
---

<SiteLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image={featured?.image.src}
  lang="ko"
  mainLabelledBy="creations-title"
>
  <div class="creations-page">
    <PageHero
      kicker="WORKS / CREATIONS"
      title="음악과 창작 실험"
      titleId="creations-title"
      lede="AI를 악기처럼 사용해 상상하던 음악을 실제 결과물로 만듭니다. 노래, 커버 이미지, 가사 영상과 창작 과정을 다듬는 작은 도구들을 이곳에 모읍니다."
    >
      <p class="meta creations-hero__eyebrow" slot="top">My Creations</p>
      <div class="creations-hero__aside">
        <TextLink
          class="creations-hero__youtube"
          href={YOUTUBE_CHANNEL_URL}
          target="_blank"
          rel="noopener noreferrer"
          direction="external">YouTube 채널</TextLink
        >
        <aside class="creations-hero__note" aria-label="창작 노트">
          <p class="kicker">STUDIO NOTE · 2026</p>
          <p>“AI가 대신 만드는 것보다, 내가 무엇을 남기고 버릴지 고르는 과정에 더 가깝다.”</p>
        </aside>
      </div>
    </PageHero>

    <div class="shell creations-page__body">
      {
        featured && (
          <section id="featured-creation" class="featured" aria-labelledby="featured-title">
            <a
              class="featured__artwork"
              href={featured.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${featured.title} YouTube에서 듣기`}
            >
              <Image
                src={featured.image}
                alt={featured.imageAlt}
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) calc(100vw - 48px), 640px"
                loading="eager"
                decoding="async"
              />
            </a>
            <div class="featured__content">
              <p class="kicker">01 / FEATURED TRACK</p>
              <p class="meta featured__subtitle">{featured.subtitle}</p>
              <h2 id="featured-title">{featured.title}</h2>
              <p class="featured__description">{featured.description}</p>
              <ul class="meta featured__tags" aria-label={`${featured.title} 특징`}>
                {featured.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <div class="featured__actions">
                <TextLink
                  href={featured.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  direction="external"
                >
                  YouTube에서 듣기
                </TextLink>
                {featured.relatedRecord && (
                  <TextLink href={featured.relatedRecord}>만든 과정 읽기</TextLink>
                )}
              </div>
            </div>
          </section>
        )
      }

      <section class="archive" aria-labelledby="archive-title">
        <SectionHead kicker="02 / SELECTED WORK" title="전체 발매곡" titleId="archive-title">
          <p class="archive__lede">
            현재 공개한 {creations.length}곡을 모두 모았습니다. 한 곡마다 다른 장면과 감정을 골라,
            음악과 화면의 호흡을 새로 설계합니다.
          </p>
        </SectionHead>
        <div class="archive__list">
          {archive.map((creation, index) => <CreationCard creation={creation} index={index + 1} />)}
        </div>
      </section>

      <section class="journal" aria-labelledby="journal-title">
        <p class="kicker">03 / CREATION JOURNAL</p>
        <h2 id="journal-title">결과물 뒤의 선택도 기록합니다</h2>
        <p>
          첫 AI 음악을 만들며 느낀 점, 이미지와 영상 도구를 연결한 과정, 그리고 결국 사람이 판단해야
          했던 순간을 글로 남겼습니다.
        </p>
        <TextLink href="/records/meta/ai-music-with-suno/">창작 노트 읽기</TextLink>
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .creations-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .creations-hero__aside {
    display: grid;
    grid-template-columns: auto minmax(0, 340px);
    gap: 2rem 4rem;
    align-items: start;
    justify-content: space-between;
    margin-top: 2.5rem;
  }

  .creations-hero__note {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule-accent);
  }

  .creations-hero__note p {
    margin: 0;
  }

  .creations-hero__note p:last-child {
    margin-top: 0.85rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.95;
    word-break: keep-all;
  }

  .creations-page__body {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 75px);
    align-items: center;
    padding: 0 0 clamp(80px, 10vw, 130px);
    border-bottom: 1px solid var(--line);
  }

  .featured__artwork {
    display: block;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .featured__artwork :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--motion-fast) ease;
  }

  .featured__artwork:hover :global(img) {
    opacity: 0.85;
  }

  .featured__subtitle {
    margin: 1.5rem 0 0;
  }

  .featured h2 {
    margin: 0.6rem 0 1rem;
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.35;
  }

  .featured__description {
    margin: 0;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .featured__tags {
    display: flex;
    flex-wrap: wrap;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .featured__tags li + li::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
  }

  .archive {
    padding-top: clamp(90px, 11vw, 150px);
  }

  .archive__lede {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .archive__list {
    border-top: 1px solid var(--line);
  }

  .journal {
    max-width: 780px;
    margin-top: clamp(90px, 11vw, 150px);
    padding-top: 42px;
    border-top: 1px solid var(--line-strong);
  }

  .journal h2 {
    margin: 1rem 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.5;
  }

  .journal p:not(.kicker) {
    margin: 0 0 1.75rem;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .creations-hero__aside {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
