---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/observatory/PageHero.astro';
import SeriesCard from '../../components/records/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { seriesList } from '../../data/series';

const posts = await getCollection('blog');
const seriesCards = seriesList
  .map((item) => ({
    ...item,
    posts: posts.filter((post) => post.data.series === item.slug),
  }))
  .filter((item) => item.posts.length > 0);
---

<SiteLayout
  title={`시리즈 | ${SITE_TITLE}`}
  description="기록실 책장에 꽂아둔 긴 기록들을 모았습니다."
  lang="ko"
  mainLabelledBy="series-title"
>
  <div class="series-page">
    <PageHero
      kicker="COLLECTION / SERIES"
      title="시리즈"
      titleId="series-title"
      lede="기록실 책장에 꽂아둔 긴 기록들입니다. AI, Backend, Agent, 그리고 만냥구름의 이야기를 흐름으로 정리합니다."
    />

    <section class="shell series-page__content" aria-label="시리즈 목록">
      <p class="kicker series-page__count">{seriesCards.length} SHELVES</p>
      <div class="series-grid">
        {
          seriesCards.map((item, index) => (
            <SeriesCard seriesItem={item} count={item.posts.length} index={index + 1} />
          ))
        }
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .series-page__content {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .series-page__count {
    margin: 0 0 1.5rem;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 75px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .series-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
