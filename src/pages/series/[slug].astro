---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PageHero from '../../components/observatory/PageHero.astro';
import SectionHead from '../../components/observatory/SectionHead.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { getCategory } from '../../data/categories';
import { getSeriesStatusLabel, seriesList, type SeriesEntry } from '../../data/series';
import { routes } from '../../utils/routes';
import { sortSeriesPosts } from '../../utils/seriesPosts';

type Props = {
  seriesItem: SeriesEntry;
  posts: CollectionEntry<'blog'>[];
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return seriesList
    .map((seriesItem) => ({
      seriesItem,
      posts: posts.filter((post) => post.data.series === seriesItem.slug).sort(sortSeriesPosts),
    }))
    .filter(({ posts }) => posts.length > 0)
    .map(({ seriesItem, posts }) => ({
      params: { slug: seriesItem.slug },
      props: { seriesItem, posts },
    }));
}

const { seriesItem, posts } = Astro.props as Props;
const category = getCategory(seriesItem.category);
const statusLabel = getSeriesStatusLabel(seriesItem.status);
const shelfItems = [
  seriesItem.purpose?.trim() ? { label: '모은 이유', value: seriesItem.purpose.trim() } : undefined,
  seriesItem.readingPromise?.trim()
    ? { label: '읽고 나면', value: seriesItem.readingPromise.trim() }
    : undefined,
].filter((item): item is { label: string; value: string } => Boolean(item));
const recordCount = String(posts.length).padStart(2, '0');
---

<SiteLayout
  title={`${seriesItem.title} | ${SITE_TITLE}`}
  description={seriesItem.description}
  lang="ko"
  mainLabelledBy="series-detail-title"
>
  <div class="series-detail">
    <PageHero
      kicker={`SERIES / ${recordCount} POSTS`}
      title={seriesItem.title}
      titleId="series-detail-title"
      lede={seriesItem.description}
    >
      <p class="meta series-detail__breadcrumbs" slot="top">
        <a href={routes.series}>시리즈</a>
        <span aria-hidden="true">/</span>
        <span>{seriesItem.title}</span>
      </p>
      <div class="meta series-detail__meta" aria-label="시리즈 정보">
        <span>{category.label}</span>
        <span>글 {posts.length}편</span>
        {statusLabel && <span>{statusLabel}</span>}
      </div>
    </PageHero>

    <div class="shell series-detail__body">
      {
        shelfItems.length > 0 && (
          <section class="series-detail__shelf" aria-label="시리즈 소개">
            {shelfItems.map((item) => (
              <div class="series-detail__shelf-row">
                <p class="meta">{item.label}</p>
                <strong>{item.value}</strong>
              </div>
            ))}
          </section>
        )
      }

      <section class="series-detail__records" aria-labelledby="series-records-title">
        <SectionHead kicker="READING ORDER" title="읽는 순서" titleId="series-records-title">
          <p class="meta series-detail__records-note">모두 {posts.length}편</p>
        </SectionHead>

        <ol class="series-detail__list">
          {
            posts.map((post, index) => {
              const orderLabel = String(post.data.seriesOrder ?? index + 1).padStart(2, '0');

              return (
                <li class="series-detail__item" data-series-order={orderLabel}>
                  <span class="series-detail__order">{orderLabel}</span>
                  <div class="series-detail__item-body">
                    <h3>
                      <a href={routes.record(post.id)}>{post.data.title}</a>
                    </h3>
                    <p>{post.data.description}</p>
                  </div>
                  <FormattedDate class="series-detail__date" date={post.data.pubDate} />
                </li>
              );
            })
          }
        </ol>
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .series-detail__breadcrumbs,
  .series-detail__meta {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .series-detail__breadcrumbs span[aria-hidden] {
    margin: 0 0.6em;
  }

  .series-detail__breadcrumbs a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .series-detail__breadcrumbs a:hover {
    color: var(--fg);
  }

  .series-detail__meta {
    margin-top: 1.75rem;
  }

  .series-detail__meta span + span::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .series-detail__body {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .series-detail__shelf {
    margin-bottom: clamp(80px, 10vw, 120px);
    border-bottom: 1px solid var(--line);
  }

  .series-detail__shelf-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 40px;
    padding: 38px 0;
    border-top: 1px solid var(--line);
  }

  .series-detail__shelf-row p {
    margin: 0.4rem 0 0;
  }

  .series-detail__shelf-row strong {
    max-width: 44rem;
    color: var(--fg);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 400;
    line-height: 1.85;
    word-break: keep-all;
  }

  .series-detail__records-note {
    margin: 0.75rem 0 0;
  }

  .series-detail__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .series-detail__item {
    position: relative;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 120px;
    gap: 18px;
    align-items: baseline;
    padding: 30px 2px;
    border-bottom: 1px solid var(--line);
    transition: padding var(--motion-fast) ease;
  }

  .series-detail__item:hover {
    padding-left: 13px;
  }

  .series-detail__order,
  .series-detail__item :global(.series-detail__date) {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: var(--label-xs);
  }

  .series-detail__order {
    letter-spacing: 0.14em;
  }

  .series-detail__item :global(.series-detail__date) {
    text-align: right;
    letter-spacing: 0.04em;
  }

  .series-detail__item-body {
    min-width: 0;
  }

  .series-detail__item h3 {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 400;
    line-height: 1.65;
  }

  .series-detail__item h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .series-detail__item h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .series-detail__item:hover h3 a {
    color: var(--fg-strong);
  }

  .series-detail__item p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  @media (max-width: 700px) {
    .series-detail__shelf-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 28px 0;
    }

    .series-detail__item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
      padding: 22px 0;
    }

    .series-detail__item:hover {
      padding-left: 0;
    }

    .series-detail__item-body {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }
</style>
