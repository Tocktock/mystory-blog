---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import BookshelfSection from '../components/home/BookshelfSection.astro';
import RecentRecords from '../components/home/RecentRecords.astro';
import ManyangGureumCard from '../components/home/ManyangGureumCard.astro';
import CreationsCard from '../components/home/CreationsCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { buildPersonJsonLd, buildWebsiteJsonLd } from '../utils/jsonld';
import { routes } from '../utils/routes';
import { serializeJsonLd } from '../utils/serializeJsonLd';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 4);
const seriesCount = new Set(
  allPosts.map((post) => post.data.series).filter((series): series is string => Boolean(series)),
).size;
const latestPost = allPosts[0];
const latestRecordTitle = latestPost?.data.title ?? '아직 글이 없어요';
const latestRecordHref = latestPost ? routes.record(latestPost.id) : undefined;

const siteURL = (Astro.site ?? Astro.url).toString();
const websiteJsonLd = buildWebsiteJsonLd({
  siteUrl: siteURL,
  title: SITE_TITLE,
  description: SITE_DESCRIPTION,
});
const personJsonLd = buildPersonJsonLd(siteURL);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang="ko">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(websiteJsonLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(personJsonLd)}
  />
  <div class="home-page">
    <HeroSection
      recordCount={allPosts.length}
      seriesCount={seriesCount}
      latestRecordTitle={latestRecordTitle}
      latestRecordHref={latestRecordHref}
      latestRecordDate={latestPost?.data.pubDate}
    />
    <RecentRecords posts={posts} />
    <BookshelfSection />
    <CreationsCard />
    <ManyangGureumCard />
  </div>
</SiteLayout>

<style>
  .home-page {
    overflow-x: clip;
  }
</style>
