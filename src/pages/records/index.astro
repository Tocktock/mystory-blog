---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EntryList from '../../components/observatory/EntryList.astro';
import PageHero from '../../components/observatory/PageHero.astro';
import RecordCard from '../../components/records/RecordCard.astro';
import RecordFilters from '../../components/records/RecordFilters.astro';
import TextLink from '../../components/observatory/TextLink.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { categoryList } from '../../data/categories';
import { getRecordType } from '../../data/recordTypes';
import { routes } from '../../utils/routes';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const activeCategorySlugs = new Set(posts.map((post) => post.data.category));
const activeCategories = categoryList.filter((category) => activeCategorySlugs.has(category.slug));
const recordTypeCounts = posts.reduce((counts, post) => {
  const recordType = getRecordType(post.data.recordType);
  if (recordType) {
    counts.set(recordType.label, (counts.get(recordType.label) ?? 0) + 1);
  }
  return counts;
}, new Map<string, number>());
const recordTypeSummary = Array.from(recordTypeCounts.entries());
---

<SiteLayout
  title={`기록 | ${SITE_TITLE}`}
  description="기술, 일상, 생각, 프로젝트, 만냥구름의 기록을 모았습니다."
  lang="ko"
  mainLabelledBy="records-title"
>
  <div class="records-page">
    <PageHero
      kicker="ARCHIVE / OBSERVATIONS"
      title="기록"
      titleId="records-title"
      lede="관찰하고, 실험하고, 생각한 것들. 기술, 일상, 생각, 프로젝트, 만냥구름의 기록을 모았습니다."
    />

    <section class="shell records-page__content" aria-label="기록 목록">
      <RecordFilters categories={activeCategories} />

      <div class="records-page__summary">
        <p class="kicker">{posts.length} OBSERVATIONS</p>
        <TextLink class="records-page__tags-link" href={routes.tags}>태그로 찾기</TextLink>
        {
          recordTypeSummary.length > 0 && (
            <aside class="records-page__types" aria-label="기록 갈래">
              <p class="meta">기록 갈래</p>
              <ul>
                {recordTypeSummary.map(([label, count]) => (
                  <li class="meta">
                    {label} <strong>{count}편</strong>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>

      <EntryList>
        {posts.map((post, index) => <RecordCard post={post} index={index + 1} />)}
      </EntryList>
    </section>
  </div>
</SiteLayout>

<style>
  .records-page__content {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .records-page__summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 1.5rem;
  }

  .records-page__types {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .records-page__types p,
  .records-page__types ul {
    margin: 0;
  }

  .records-page__types ul {
    display: flex;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .records-page__types strong {
    color: var(--fg);
    font-weight: 500;
  }
</style>
