---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EntryList from '../../components/observatory/EntryList.astro';
import EntryRow from '../../components/observatory/EntryRow.astro';
import PageHero from '../../components/observatory/PageHero.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { collectTags, type TagEntry } from '../../utils/tags';
import { routes } from '../../utils/routes';

type Props = {
  tag: TagEntry;
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = collectTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props as Props;
const tagPosts = tag.posts as CollectionEntry<'blog'>[];
---

<SiteLayout
  title={`${tag.label} 기록 | ${SITE_TITLE}`}
  description={`${tag.label} 태그가 붙은 글이에요.`}
  lang="ko"
  mainLabelledBy="tag-detail-title"
>
  <div class="tag-detail">
    <PageHero
      kicker="TAG"
      title={tag.label}
      titleId="tag-detail-title"
      lede={`글 ${tagPosts.length}편`}
    >
      <p class="meta tag-detail__breadcrumbs" slot="top">
        <a href={routes.tags}>태그</a>
        <span aria-hidden="true">/</span>
        <span>{tag.label}</span>
      </p>
    </PageHero>
    <section class="shell tag-detail__content" aria-label={`${tag.label} 기록 목록`}>
      <EntryList>
        {
          tagPosts.map((post, index) => (
            <EntryRow
              href={routes.record(post.id)}
              title={post.data.title}
              index={index + 1}
              date={post.data.pubDate}
              headingLevel={2}
            >
              <p class="tag-detail__description">{post.data.description}</p>
            </EntryRow>
          ))
        }
      </EntryList>
    </section>
  </div>
</SiteLayout>

<style>
  .tag-detail__breadcrumbs {
    margin: 0;
  }

  .tag-detail__breadcrumbs a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .tag-detail__breadcrumbs span[aria-hidden] {
    margin: 0 0.6em;
  }

  .tag-detail__content {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .tag-detail__description {
    max-width: 46rem;
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }
</style>
