---
import { Image } from 'astro:assets';
import type { CatProfile } from '../../data/cats';

interface Props {
  cat: CatProfile;
}

const { cat } = Astro.props as Props;
---

<article class={`cat-profile cat-profile--${cat.id}`}>
  <div class="cat-profile__image-frame">
    <Image
      src={cat.image}
      alt={cat.imageAlt}
      widths={[320, 480, 640]}
      sizes="(max-width: 700px) calc(100vw - 48px), 320px"
      loading="lazy"
      decoding="async"
      class="cat-profile__image"
    />
  </div>

  <div class="cat-profile__body">
    <p class="meta cat-profile__role">{cat.role}</p>
    <h3>{cat.name}</h3>
    <p class="cat-profile__description">{cat.description}</p>

    <div class="cat-profile__facts">
      <div class="cat-profile__section">
        <h4>성격</h4>
        <ul>
          {cat.personality.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="cat-profile__section">
        <h4>좋아하는 것</h4>
        <ul>
          {cat.likes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</article>

<style>
  .cat-profile {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    padding: 42px 0;
    border-bottom: 1px solid var(--line);
  }

  .cat-profile__image-frame {
    border: 1px solid var(--line);
    background: var(--bg-raised);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .cat-profile__image-frame :global(.cat-profile__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-profile__role {
    margin: 0;
  }

  .cat-profile h3 {
    margin: 0.75rem 0 1rem;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1.3;
  }

  .cat-profile__description {
    max-width: 38rem;
    margin: 0;
    color: var(--text);
    line-height: 2;
    word-break: keep-all;
  }

  .cat-profile__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .cat-profile__section h4 {
    margin: 0;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .cat-profile__section ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cat-profile__section li {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  @media (max-width: 760px) {
    .cat-profile {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 0;
    }

    .cat-profile__image-frame {
      max-width: 360px;
    }
  }

  @media (max-width: 480px) {
    .cat-profile__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
