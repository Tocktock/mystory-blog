---
import CatPhotoCard from './CatPhotoCard.astro';
import SectionHead from '../observatory/SectionHead.astro';
import { catMoodLabels, type CatMood, type CatPhoto } from '../../data/catGallery';

interface Props {
  photos: CatPhoto[];
  kicker?: string;
}

const { photos, kicker = 'GALLERY' } = Astro.props as Props;

const moodGroups = (Object.entries(catMoodLabels) as [CatMood, string][])
  .map(([mood, label]) => ({
    mood,
    label,
    photos: photos.filter((photo) => photo.mood === mood),
  }))
  .filter((group) => group.photos.length > 0);
---

<section class="cat-gallery" aria-labelledby="cat-gallery-title">
  <SectionHead kicker={kicker} title="사진첩" titleId="cat-gallery-title">
    <p class="cat-gallery__lede">이불 위에서 쉬고, 낮잠 자고, 나란히 붙어 있는 모습들이에요.</p>
  </SectionHead>

  <nav class="cat-gallery__nav" aria-label="사진첩 분류">
    {
      moodGroups.map((group) => (
        <a href={`#cat-mood-${group.mood}`}>
          {group.label} <span>{group.photos.length}</span>
        </a>
      ))
    }
  </nav>

  <div class="cat-gallery__groups">
    {
      moodGroups.map((group) => (
        <section
          id={`cat-mood-${group.mood}`}
          class="cat-gallery__group"
          aria-labelledby={`cat-mood-title-${group.mood}`}
        >
          <h3 id={`cat-mood-title-${group.mood}`}>{group.label}</h3>
          <div class="cat-gallery__grid">
            {group.photos.map((photo) => (
              <CatPhotoCard photo={photo} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  .cat-gallery__lede {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .cat-gallery__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .cat-gallery__nav a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .cat-gallery__nav a span {
    color: var(--dim);
  }

  .cat-gallery__nav a:hover {
    color: var(--fg);
  }

  .cat-gallery__group {
    padding-top: clamp(48px, 6vw, 72px);
    scroll-margin-top: 1.5rem;
  }

  .cat-gallery__group h3 {
    margin: 0 0 1.5rem;
    color: var(--fg);
    font-size: 1.15rem;
  }

  .cat-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }

  @media (max-width: 1100px) {
    .cat-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cat-gallery__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
