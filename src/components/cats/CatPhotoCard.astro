---
import { Image } from 'astro:assets';
import { catMap } from '../../data/cats';
import { catMoodLabels, type CatPhoto } from '../../data/catGallery';

interface Props {
  photo: CatPhoto;
}

const { photo } = Astro.props as Props;
const catNames = photo.cats.map((catId) => catMap[catId].name);
const moodLabel = catMoodLabels[photo.mood];
---

<figure class="cat-photo">
  <div class="cat-photo__frame">
    <Image
      src={photo.image}
      alt={photo.alt}
      widths={[320, 480, 640, 960]}
      sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1100px) 50vw, 380px"
      loading="lazy"
      decoding="async"
      class="cat-photo__image"
    />
  </div>
  <figcaption class="cat-photo__caption">
    <span class="meta cat-photo__mood">{moodLabel} / {catNames.join(' · ')}</span>
    <strong>{photo.caption}</strong>
  </figcaption>
</figure>

<style>
  .cat-photo {
    margin: 0;
  }

  .cat-photo__frame {
    background: var(--bg-raised);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .cat-photo__frame :global(.cat-photo__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-photo__caption {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.9rem;
  }

  .cat-photo__caption strong {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.75;
    word-break: keep-all;
  }
</style>
