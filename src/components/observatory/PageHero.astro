---
import { getImage } from 'astro:assets';
import deepField from '../../assets/observatory/deep-field.png';

interface Props {
  kicker: string;
  title: string;
  titleId?: string;
  lede?: string;
  headingLevel?: 1 | 2;
  class?: string;
}

const { kicker, title, titleId, lede, headingLevel = 1, class: className } = Astro.props as Props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const background = await getImage({ src: deepField, width: 1672, format: 'webp', quality: 72 });
---

<section
  class:list={['page-hero', className]}
  style={`--page-hero-image: url('${background.src}')`}
>
  <div class="shell page-hero__inner">
    <slot name="top" />
    <p class="kicker page-hero__kicker">{kicker}</p>
    <Heading class="page-hero__title" id={titleId}>{title}</Heading>
    {lede && <p class="page-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 490px;
    margin-top: calc(-1 * var(--header-height));
    padding: 235px 0 110px;
    isolation: isolate;
  }

  .page-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--page-hero-image) center top / cover no-repeat;
    opacity: 0.16;
    mask-image: linear-gradient(#000, transparent);
    pointer-events: none;
  }

  .page-hero__title {
    max-width: 18ch;
    margin: 22px 0;
    font-size: clamp(2.5rem, 5.5vw, 4.9rem);
    line-height: 1.25;
  }

  .page-hero__lede {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 2;
    word-break: keep-all;
  }

  @media (max-width: 700px) {
    .page-hero {
      min-height: 390px;
      padding: 175px 0 64px;
    }
  }
</style>
