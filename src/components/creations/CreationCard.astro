---
import { Image } from 'astro:assets';
import TextLink from '../observatory/TextLink.astro';
import type { Creation } from '../../data/creations';

interface Props {
  creation: Creation;
  index?: number;
}

const { creation, index } = Astro.props as Props;
const number = typeof index === 'number' ? String(index).padStart(2, '0') : undefined;
---

<article class="creation-card">
  <a
    class="creation-card__artwork"
    href={creation.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${creation.title} YouTube에서 듣기`}
  >
    <Image
      src={creation.image}
      alt={creation.imageAlt}
      widths={[360, 540, 720]}
      sizes="(max-width: 700px) calc(100vw - 48px), 240px"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="creation-card__content">
    <p class="meta creation-card__subtitle">
      {number && <span class="creation-card__number">{number}</span>}
      <span>{creation.subtitle}</span>
    </p>
    <h3>{creation.title}</h3>
    <p class="creation-card__description">{creation.description}</p>
    <ul class="meta creation-card__tags" aria-label={`${creation.title} 특징`}>
      {creation.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <TextLink
      class="creation-card__link"
      href={creation.href}
      target="_blank"
      rel="noopener noreferrer"
      direction="external">YouTube에서 듣기</TextLink
    >
  </div>
</article>

<style>
  .creation-card {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding: 38px 0;
    border-bottom: 1px solid var(--line);
  }

  .creation-card__artwork {
    display: block;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .creation-card__artwork :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--motion-fast) ease;
  }

  .creation-card__artwork:hover :global(img) {
    opacity: 0.82;
  }

  .creation-card__subtitle {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .creation-card__subtitle span + span::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .creation-card__number {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  .creation-card h3 {
    margin: 0.75rem 0 0.6rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.5;
  }

  .creation-card__description {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.9;
    word-break: keep-all;
  }

  .creation-card__tags {
    display: flex;
    flex-wrap: wrap;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .creation-card__tags li + li::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .creation-card :global(.creation-card__link) {
    margin-top: 1.25rem;
  }

  @media (max-width: 700px) {
    .creation-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 30px 0;
    }
  }
</style>
