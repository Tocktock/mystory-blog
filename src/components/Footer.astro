---
import { SITE_TITLE } from '../consts';
import { navLinks } from '../data/siteNavigation';

const today = new Date();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__mark">
      <span class="kicker">THE MIDNIGHT OBSERVATORY</span>
      <span class="site-footer__title">{SITE_TITLE}</span>
    </p>
    <nav class="site-footer__nav" aria-label="사이트 바로가기">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href="https://github.com/Tocktock" rel="noopener noreferrer">GitHub</a>
        </li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <p class="site-footer__copyright">&copy; {today.getFullYear()} JI YONG</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }

  .site-footer__inner {
    display: flex;
    max-width: 1250px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    margin: 0 auto;
    padding: 45px clamp(24px, 5vw, 60px) 65px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  .site-footer__mark {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .site-footer__title {
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .site-footer__nav ul {
    display: flex;
    gap: 0.5rem 1.6rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--muted);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--fg);
  }

  .site-footer__copyright {
    margin: 0;
    letter-spacing: 0.14em;
  }

  @media (max-width: 700px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 36px 24px 50px;
    }
  }
</style>
