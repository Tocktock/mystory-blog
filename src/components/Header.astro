---
import { getCollection } from 'astro:content';
import HeaderLink from './HeaderLink.astro';
import { creations } from '../data/creations';
import { navLinks } from '../data/siteNavigation';
import { routes } from '../utils/routes';

const pad = (value: number) => String(value).padStart(2, '0');

// Live counts appended to a few menu hints, e.g. "지금까지 쓴 글 · 67편".
const posts = await getCollection('blog');
const seriesCount = new Set(posts.map((post) => post.data.series).filter(Boolean)).size;
const counts: Record<string, string> = {
  [routes.records]: `${posts.length}편`,
  [routes.series]: `${seriesCount}개`,
  [routes.creations]: `${creations.length}곡`,
};
---

<a class="skip-link" href="#main" data-pagefind-ignore>본문 바로가기</a>
<header class="site-header" data-pagefind-ignore>
  <a class="site-header__brand" href="/">JI YONG</a>
  <button
    class="site-header__index"
    type="button"
    aria-haspopup="dialog"
    aria-controls="index-dialog"
    aria-expanded="false"
    data-index-open
  >
    INDEX <span class="site-header__plus" aria-hidden="true">+</span>
  </button>
</header>

<dialog
  id="index-dialog"
  class="index-dialog"
  aria-labelledby="index-dialog-title"
  data-pagefind-ignore
>
  <div class="index-dialog__head">
    <p class="kicker" id="index-dialog-title">
      <span class="index-dialog__brand">THE MIDNIGHT OBSERVATORY / </span>INDEX
    </p>
    <button class="index-dialog__close" type="button" data-index-close>
      CLOSE <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav class="index-dialog__nav" aria-label="Primary">
    <ol>
      {
        navLinks.map((link, index) => {
          const hintId = `index-hint-${index + 1}`;
          const count = counts[link.href];
          return (
            <li style={`--i: ${index}`}>
              <HeaderLink
                href={link.href}
                class="index-dialog__link"
                aria-describedby={hintId}
                data-index-link
              >
                <span class="index-dialog__num" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <span class="index-dialog__label">{link.label}</span>
                <span class="index-dialog__hint" id={hintId} aria-hidden="true">
                  {link.hint}
                  {count && <span class="index-dialog__count"> · {count}</span>}
                </span>
                <span class="index-dialog__arrow" aria-hidden="true">
                  ↗
                </span>
              </HeaderLink>
            </li>
          );
        })
      }
    </ol>
  </nav>
  <div class="index-dialog__foot">
    <p class="meta index-dialog__keys" aria-hidden="true">↑ ↓ 이동 · 1–7 바로 가기 · ESC 닫기</p>
    <p class="kicker index-dialog__site">JI-YONG.COM</p>
    <a class="index-dialog__external" href="https://github.com/Tocktock" rel="noopener noreferrer">
      GITHUB <span aria-hidden="true">↗</span>
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#index-dialog');
  const openButton = document.querySelector<HTMLButtonElement>('[data-index-open]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-index-close]');

  if (dialog && openButton) {
    const links = Array.from(dialog.querySelectorAll<HTMLAnchorElement>('[data-index-link]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Undoes a pending fade-out (its timer and listener) so it can never close a later opening.
    let cancelPendingClose = () => {};

    const finishClose = () => {
      cancelPendingClose();
      dialog.classList.remove('is-closing');
      if (dialog.open) dialog.close();
    };

    // Fade out before closing; fall back to an instant close if the animation never runs.
    const closeMenu = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reducedMotion.matches) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      const onEnd = (event: AnimationEvent) => {
        if (event.target === dialog && event.animationName === 'index-fade-out') finishClose();
      };
      const fallback = window.setTimeout(finishClose, 400);
      dialog.addEventListener('animationend', onEnd);
      cancelPendingClose = () => {
        window.clearTimeout(fallback);
        dialog.removeEventListener('animationend', onEnd);
        cancelPendingClose = () => {};
      };
    };

    openButton.addEventListener('click', () => {
      cancelPendingClose();
      dialog.classList.remove('is-closing');
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      // Start on the page you are on (or the first item) instead of the close button.
      (links.find((link) => link.getAttribute('aria-current') === 'page') ?? links[0])?.focus();
    });

    closeButton?.addEventListener('click', closeMenu);

    // Escape: animate the close where the browser lets us intercept it.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    });

    // A click on empty space (not on a row or control) closes the menu.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.matches('.index-dialog__nav, .index-dialog__nav ol')) {
        closeMenu();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      const focusAt = (index: number) => links[(index + links.length) % links.length]?.focus();

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        focusAt(current < 0 ? 0 : current + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        focusAt(current < 0 ? links.length - 1 : current - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        focusAt(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        focusAt(links.length - 1);
      } else if (/^[1-9]$/.test(event.key) && Number(event.key) <= links.length) {
        event.preventDefault();
        links[Number(event.key) - 1]?.click();
      }
    });

    dialog.addEventListener('close', () => {
      cancelPendingClose();
      dialog.classList.remove('is-closing');
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    });

    // Coming back with the browser's back button can restore the page with the menu still open.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 clamp(24px, 5vw, 88px);
    font-family: var(--font-mono);
    font-size: var(--label-md);
  }

  .site-header__brand {
    color: var(--fg);
    letter-spacing: 0.42em;
    text-decoration: none;
  }

  .site-header__index,
  .index-dialog__close {
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.18em;
  }

  .site-header__plus {
    margin-left: 0.75rem;
    color: var(--muted);
  }

  .site-header__brand:hover,
  .site-header__index:hover,
  .index-dialog__close:hover {
    color: var(--accent);
  }

  /* The page behind the open menu should not scroll. */
  :global(html:has(.index-dialog[open])) {
    overflow: hidden;
  }

  .index-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(20px, 4vh, 45px) clamp(24px, 7vw, 110px);
    border: 0;
    background: var(--bg-raised);
    color: var(--fg);
    /* Everything is sized to fit one screen; scrolling is only a fallback for very short windows. */
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .index-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: index-fade-in 0.28s ease-out both;
  }

  .index-dialog.is-closing {
    animation: index-fade-out 0.2s ease-in both;
  }

  .index-dialog::backdrop {
    background: var(--bg);
  }

  .index-dialog__close {
    white-space: nowrap;
  }

  .index-dialog__head,
  .index-dialog__foot {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .index-dialog__nav {
    display: flex;
    flex: 1;
    align-items: center;
    padding: clamp(8px, 2.5vh, 40px) 0;
  }

  .index-dialog__nav ol {
    width: min(100%, 920px);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .index-dialog__nav li {
    position: relative;
  }

  /* Row rules draw in left to right as each row arrives. */
  .index-dialog__nav li::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: '';
    background: var(--line);
    transform-origin: left center;
  }

  .index-dialog[open] .index-dialog__nav li {
    animation: index-row-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(90ms + var(--i) * 45ms);
  }

  .index-dialog[open] .index-dialog__nav li::after {
    animation: index-rule-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(90ms + var(--i) * 45ms);
  }

  .index-dialog__nav :global(.index-dialog__link) {
    display: grid;
    grid-template-columns: 3.5rem auto minmax(0, 1fr) auto;
    gap: 0 1.25rem;
    align-items: baseline;
    padding: clamp(6px, 1.5vh, 16px) 0;
    color: var(--fg);
    font-weight: 400;
    text-decoration: none;
  }

  .index-dialog__num {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.1em;
    transition: color var(--motion-fast) ease;
  }

  .index-dialog__label {
    font-size: clamp(1.4rem, min(4.2vh, 3vw), 2.3rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    transition:
      color var(--motion-fast) ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .index-dialog__hint {
    justify-self: end;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.04em;
    text-align: right;
    transition: color var(--motion-fast) ease;
  }

  .index-dialog__count {
    color: var(--dim);
  }

  .index-dialog__arrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    opacity: 0;
    transform: translate(-6px, 4px);
    transition:
      opacity var(--motion-fast) ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .index-dialog__nav :global(.index-dialog__link:hover) .index-dialog__label,
  .index-dialog__nav :global(.index-dialog__link:focus-visible) .index-dialog__label {
    color: var(--accent);
    transform: translateX(10px);
  }

  .index-dialog__nav :global(.index-dialog__link:hover) .index-dialog__hint,
  .index-dialog__nav :global(.index-dialog__link:focus-visible) .index-dialog__hint {
    color: var(--text);
  }

  .index-dialog__nav :global(.index-dialog__link:hover) .index-dialog__arrow,
  .index-dialog__nav :global(.index-dialog__link:focus-visible) .index-dialog__arrow {
    opacity: 1;
    transform: none;
  }

  .index-dialog__nav :global(.index-dialog__link[aria-current='page']) .index-dialog__label,
  .index-dialog__nav :global(.index-dialog__link[aria-current='page']) .index-dialog__num {
    color: var(--accent);
  }

  /* A small dot beside the number marks the page you are on (empty content, so nothing is announced). */
  .index-dialog__nav :global(.index-dialog__link[aria-current='page']) .index-dialog__num::after {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 0.6em;
    border-radius: 50%;
    content: '';
    background: var(--accent);
    vertical-align: middle;
  }

  .index-dialog__external {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.18em;
    text-decoration: none;
  }

  .index-dialog__keys {
    display: none;
    margin: 0;
  }

  /* Keyboard hints only where a keyboard is likely; otherwise show the site address. */
  @media (hover: hover) and (pointer: fine) {
    .index-dialog__keys {
      display: block;
    }

    .index-dialog__site {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .index-dialog__brand {
      display: none;
    }

    .index-dialog__nav :global(.index-dialog__link) {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      grid-template-areas:
        'num label arrow'
        '. hint arrow';
      gap: 0.15rem 0.75rem;
    }

    .index-dialog__num {
      grid-area: num;
    }

    .index-dialog__label {
      grid-area: label;
      font-size: clamp(1.2rem, 3.4vh, 1.75rem);
    }

    .index-dialog__hint {
      grid-area: hint;
      justify-self: start;
      text-align: left;
    }

    .index-dialog__arrow {
      grid-area: arrow;
      align-self: center;
    }
  }

  /* Short phones stack the hint under the label, which costs height; drop it there. */
  @media (max-width: 700px) and (max-height: 720px) {
    .index-dialog__hint {
      display: none;
    }
  }

  /* Very short windows (phones in landscape): smaller rows, no footer. */
  @media (max-height: 520px) {
    .index-dialog {
      padding-block: 14px;
    }

    .index-dialog__nav {
      padding-block: 6px;
    }

    .index-dialog__nav :global(.index-dialog__link) {
      padding-block: 5px;
    }

    .index-dialog__label {
      font-size: 1.15rem;
    }

    .index-dialog__foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-dialog[open],
    .index-dialog[open] .index-dialog__nav li,
    .index-dialog[open] .index-dialog__nav li::after {
      animation: none;
    }
  }

  @keyframes index-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes index-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes index-row-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes index-rule-in {
    from {
      transform: scaleX(0);
    }
  }
</style>
