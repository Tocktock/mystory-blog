---
import HeaderLink from './HeaderLink.astro';
import { navLinks } from '../data/siteNavigation';

const pad = (value: number) => String(value).padStart(2, '0');
---

<a class="skip-link" href="#main" data-pagefind-ignore>본문 바로가기</a>
<header class="site-header" data-pagefind-ignore>
  <a class="site-header__brand" href="/">JI YONG</a>
  <button
    class="site-header__index"
    type="button"
    aria-haspopup="dialog"
    aria-controls="index-dialog"
    aria-expanded="false"
    data-index-open
  >
    INDEX <span class="site-header__plus" aria-hidden="true">+</span>
  </button>
</header>

<dialog
  id="index-dialog"
  class="index-dialog"
  aria-labelledby="index-dialog-title"
  data-pagefind-ignore
>
  <div class="index-dialog__head">
    <p class="kicker" id="index-dialog-title">THE MIDNIGHT OBSERVATORY / INDEX</p>
    <button class="index-dialog__close" type="button" data-index-close>
      CLOSE <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav class="index-dialog__nav" aria-label="Primary">
    <ol>
      {
        navLinks.map((link, index) => (
          <li>
            <HeaderLink href={link.href} class="index-dialog__link">
              <span class="index-dialog__num" aria-hidden="true">
                {pad(index + 1)}
              </span>
              {link.label}
            </HeaderLink>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="index-dialog__foot">
    <p class="kicker">AN ARCHIVE IN DEEP SPACE</p>
    <a class="index-dialog__external" href="https://github.com/Tocktock" rel="noopener noreferrer">
      GITHUB <span aria-hidden="true">↗</span>
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#index-dialog');
  const openButton = document.querySelector<HTMLButtonElement>('[data-index-open]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-index-close]');

  if (dialog && openButton) {
    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 clamp(24px, 5vw, 88px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .site-header__brand {
    color: var(--fg);
    letter-spacing: 0.42em;
    text-decoration: none;
  }

  .site-header__index,
  .index-dialog__close {
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.18em;
  }

  .site-header__plus {
    margin-left: 0.75rem;
    color: var(--muted);
  }

  .site-header__brand:hover,
  .site-header__index:hover,
  .index-dialog__close:hover {
    color: var(--accent);
  }

  .index-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(28px, 4vw, 45px) clamp(25px, 7vw, 110px);
    border: 0;
    background: var(--bg-raised);
    color: var(--fg);
  }

  .index-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .index-dialog::backdrop {
    background: var(--bg);
  }

  .index-dialog__head,
  .index-dialog__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .index-dialog__nav {
    display: flex;
    flex: 1;
    align-items: center;
    padding: 1.5rem 0;
  }

  .index-dialog__nav ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-dialog__nav :global(.index-dialog__link) {
    display: inline-flex;
    align-items: baseline;
    padding: 0.2rem 0;
    color: var(--fg);
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .index-dialog__nav :global(.index-dialog__link:hover),
  .index-dialog__nav :global(.index-dialog__link[aria-current='page']) {
    color: var(--accent);
  }

  .index-dialog__num {
    display: inline-block;
    width: 60px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.1em;
  }

  .index-dialog__external {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.18em;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .index-dialog__nav :global(.index-dialog__link) {
      font-size: 2.1rem;
    }

    .index-dialog__num {
      width: 44px;
    }
  }
</style>
