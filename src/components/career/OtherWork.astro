---
import SectionHead from '../observatory/SectionHead.astro';
import { otherWorkItems } from '../../data/career';
---

<section class="other-work career-section" id="other-work" aria-labelledby="other-work-title">
  <SectionHead kicker="02 / OTHER WORK" title="제품·데이터·플랫폼 작업" titleId="other-work-title">
    <p class="other-work__lede">
      대표 작업 밖에서도 이어서 다룬 제품, 데이터 자동화, 운영 도구 관련 작업입니다.
    </p>
  </SectionHead>
  <div class="other-work__list">
    {
      otherWorkItems.map((item) => (
        <article class="other-work__item career-line">
          <div class="meta other-work__meta">
            <span class="other-work__area">{item.area}</span>
            {item.period ? <span class="other-work__period">{item.period}</span> : null}
          </div>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .other-work__lede {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .other-work__meta {
    display: grid;
    gap: 0.2rem;
    align-content: start;
  }

  .other-work__area {
    color: var(--muted);
  }

  .other-work__item p {
    max-width: 44rem;
    margin: 0.6rem 0 0;
  }
</style>
