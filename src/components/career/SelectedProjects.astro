---
import CareerLink from './CareerLink.astro';
import SectionHead from '../observatory/SectionHead.astro';
import { selectedProjects } from '../../data/selectedProjects';
---

<section
  class="selected-projects career-section"
  id="selected-projects"
  aria-labelledby="selected-projects-title"
>
  <SectionHead kicker="04 / WRITING" title="글과 기록" titleId="selected-projects-title" />
  <div class="selected-projects__list">
    {
      selectedProjects.map((project) => (
        <CareerLink
          class="selected-projects__item"
          href={project.href}
          external={project.external}
          plain
        >
          <span class="meta selected-projects__meta">{project.meta}</span>
          <span class="selected-projects__text">
            <strong>{project.title}</strong>
            <p>{project.description}</p>
          </span>
        </CareerLink>
      ))
    }
  </div>
</section>

<style>
  .selected-projects__list {
    border-top: 1px solid var(--line);
  }

  .selected-projects__list :global(.selected-projects__item) {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 40px;
    padding: 30px 2px;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: padding var(--motion-fast) ease;
  }

  .selected-projects__list :global(.selected-projects__item:hover) {
    padding-left: 13px;
  }

  .selected-projects__text strong {
    display: block;
    color: var(--fg);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 400;
    line-height: 1.65;
  }

  .selected-projects__list :global(.selected-projects__item:hover) strong {
    color: var(--fg-strong);
  }

  .selected-projects__text p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  @media (max-width: 700px) {
    .selected-projects__list :global(.selected-projects__item) {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 24px 0;
    }

    .selected-projects__list :global(.selected-projects__item:hover) {
      padding-left: 0;
    }
  }
</style>
