---
import SectionHead from '../observatory/SectionHead.astro';
import { careerEntries, careerProfile } from '../../data/career';

const entries = careerEntries.map((entry) => ({
  ...entry,
  details: entry.details.flatMap((group) => group.items),
}));
---

<section
  class="career-timeline career-section"
  id="career-timeline"
  aria-labelledby="career-timeline-title"
>
  <SectionHead kicker="03 / TIMELINE" title="경력" titleId="career-timeline-title" />
  <div class="career-timeline__list">
    {
      entries.map((entry) => (
        <article class="career-timeline__entry career-line">
          <div class="career-timeline__meta">
            <p class="meta">{entry.period}</p>
            <h3>{entry.company}</h3>
            <span class="meta">
              {entry.role} · {entry.position}
            </span>
          </div>
          <div class="career-timeline__body">
            <h3>{entry.headline}</h3>
            <div class="career-timeline__summary">
              <p>{entry.summary}</p>
              <p>{careerProfile.workStyle}</p>
            </div>
            {entry.highlights.length > 0 ? (
              <ul class="career-list">
                {entry.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            ) : null}
            <dl class="career-timeline__facts career-facts">
              {entry.details.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .career-timeline__meta {
    align-content: start;
  }

  .career-timeline__meta p {
    margin: 0;
  }

  .career-timeline__meta h3 {
    margin: 0.35rem 0;
    font-size: 1.1rem;
  }

  .career-timeline__meta span {
    display: block;
    word-break: keep-all;
  }

  .career-timeline__summary p {
    max-width: 44rem;
    margin: 0.75rem 0 0;
  }
</style>
