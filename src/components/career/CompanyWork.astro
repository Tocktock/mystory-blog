---
import CareerLink from './CareerLink.astro';
import SectionHead from '../observatory/SectionHead.astro';
import { companyWorkAreas } from '../../data/career';
---

<section class="company-work career-section" id="company-work" aria-labelledby="company-work-title">
  <SectionHead kicker="01 / SELECTED WORK" title="대표 작업" titleId="company-work-title" />
  <div class="company-work__list">
    {
      companyWorkAreas.map((area) => (
        <article class="company-work__row career-line">
          <div class="company-work__index" aria-label={`${area.number} ${area.label}`}>
            <span>{area.number}</span>
            <strong>{area.label}</strong>
          </div>
          <div class="company-work__body">
            <h3>{area.title}</h3>
            <div class="company-work__summary">
              {area.summary.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <ul class="company-work__items career-list">
              {area.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="company-work__meta">
              <dl class="company-work__proofs career-facts">
                {area.proofs.map((proof) => (
                  <div>
                    <dt>{proof.label}</dt>
                    <dd>{proof.value}</dd>
                  </div>
                ))}
              </dl>
              {area.links || area.relatedRecords ? (
                <nav class="company-work__links" aria-label={`${area.title} 관련 링크`}>
                  {area.links ? (
                    <div class="company-work__link-group">
                      {area.links.map((link) => (
                        <CareerLink href={link.href} external={link.external}>
                          {link.label}
                        </CareerLink>
                      ))}
                    </div>
                  ) : null}
                  {area.relatedRecords ? (
                    <div class="company-work__link-group" role="group" aria-label="관련 기록">
                      <span class="meta">관련 기록</span>
                      {area.relatedRecords.map((record) => (
                        <CareerLink href={record.href} external={record.external}>
                          {record.label}
                        </CareerLink>
                      ))}
                    </div>
                  ) : null}
                </nav>
              ) : null}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .company-work__index {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    font-family: var(--font-mono);
  }

  .company-work__index span {
    color: var(--dim);
    font-size: var(--label-xs);
    letter-spacing: 0.14em;
  }

  .company-work__index strong {
    color: var(--muted);
    font-size: var(--label-sm);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.7;
    word-break: keep-all;
  }

  .company-work__summary p {
    max-width: 44rem;
    margin: 0.75rem 0 0;
  }

  .company-work__links {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .company-work__link-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
  }
</style>
