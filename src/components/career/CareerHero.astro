---
import CareerLink from './CareerLink.astro';
import PageHero from '../observatory/PageHero.astro';
import { careerProfile } from '../../data/career';
---

<PageHero
  class="career-hero"
  kicker="RECORD / CAREER"
  title={careerProfile.thesis}
  titleId="career-title"
>
  <div class="meta career-hero__identity" slot="top">
    <span class="career-hero__eyebrow">{careerProfile.eyebrow}</span>
    <span class="career-hero__role">{careerProfile.role}</span>
  </div>

  <div class="career-hero__layout">
    <div class="career-hero__summary">
      {careerProfile.summary.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <aside class="career-hero__panel" aria-label="이력 요약">
      <dl>
        {
          careerProfile.overview.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="meta career-hero__meta">{careerProfile.meta.join(' · ')}</p>
      <nav class="career-hero__actions" aria-label="주요 링크">
        {
          careerProfile.actions.map((action) => (
            <CareerLink
              href={action.href}
              dataExternal={action.external ? 'true' : 'false'}
              external={action.external}
            >
              {action.label}
            </CareerLink>
          ))
        }
      </nav>
    </aside>
  </div>
</PageHero>

<style>
  .career-hero__identity {
    display: grid;
    gap: 0.2rem;
    margin: 0 0 0.75rem;
  }

  .career-hero__eyebrow {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  .career-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    gap: 2.5rem clamp(40px, 7vw, 110px);
    align-items: start;
  }

  .career-hero__summary p {
    max-width: 640px;
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 2;
    word-break: keep-all;
  }

  .career-hero__panel {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .career-hero__panel dl {
    margin: 0;
  }

  .career-hero__panel dl div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .career-hero__panel dt {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.04em;
    line-height: 1.9;
  }

  .career-hero__panel dd {
    margin: 0;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  .career-hero__meta {
    margin: 1rem 0 0;
  }

  .career-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 960px) {
    .career-hero__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .career-hero__panel {
      max-width: 460px;
    }
  }
</style>
