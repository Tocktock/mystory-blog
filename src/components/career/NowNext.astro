---
import CareerLink from './CareerLink.astro';
import SectionHead from '../observatory/SectionHead.astro';
import { nowNext } from '../../data/career';
---

<section class="now-next career-section" id="now-next" aria-labelledby="now-next-title">
  <SectionHead kicker="05 / NOW" title={nowNext.title} titleId="now-next-title">
    <p class="meta now-next__eyebrow">개인적으로 만드는 도구</p>
  </SectionHead>
  <div class="now-next__body career-line">
    <span class="meta" aria-hidden="true">NOW</span>
    <div>
      {nowNext.description.map((paragraph) => <p>{paragraph}</p>)}
      {
        nowNext.links.length > 0 ? (
          <nav class="now-next__links" aria-label="현재 프로젝트 링크">
            {nowNext.links.map((link) => (
              <CareerLink href={link.href} external={link.external}>
                {link.label}
              </CareerLink>
            ))}
          </nav>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .now-next__eyebrow {
    margin: 0.75rem 0 0;
  }

  .now-next__body p {
    max-width: 44rem;
    margin: 0 0 1rem;
  }

  .now-next__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
  }
</style>
