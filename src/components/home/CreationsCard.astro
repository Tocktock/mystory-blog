---
import { Image } from 'astro:assets';
import SectionHead from '../observatory/SectionHead.astro';
import TextLink from '../observatory/TextLink.astro';
import { creations } from '../../data/creations';
import { routes } from '../../utils/routes';

const featured = creations.find((creation) => creation.featured) ?? creations[0];
---

{
  featured && (
    <section class="creations-card" aria-labelledby="home-creations-title">
      <div class="shell creations-card__layout">
        <div class="creations-card__content">
          <SectionHead
            kicker="03 / MUSIC"
            title="AI로 만드는 노래"
            titleId="home-creations-title"
          />
          <p>AI로 노래를 만들고, 커버 이미지와 가사 영상까지 직접 붙여 보고 있어요.</p>
          <TextLink href={routes.creations}>노래 들으러 가기</TextLink>
        </div>
        <figure class="creations-card__artwork">
          <Image
            src={featured.image}
            alt=""
            widths={[480, 720, 960]}
            sizes="(max-width: 860px) 100vw, 46vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="meta">
            {featured.title} — {featured.subtitle}
          </figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  .creations-card {
    padding: clamp(60px, 8vw, 110px) 0;
  }

  .creations-card__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 75px);
    align-items: center;
  }

  .creations-card__content > p {
    max-width: 30rem;
    margin: 0 0 2rem;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .creations-card__artwork {
    margin: 0;
    padding-top: 25px;
    border-top: 1px solid var(--line);
  }

  .creations-card__artwork :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    opacity: 0.92;
  }

  .creations-card__artwork figcaption {
    margin-top: 1rem;
  }

  @media (max-width: 860px) {
    .creations-card__layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
