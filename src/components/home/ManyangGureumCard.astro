---
import { Image } from 'astro:assets';
import SectionHead from '../observatory/SectionHead.astro';
import TextLink from '../observatory/TextLink.astro';
import { catPhotos } from '../../data/catGallery';
import { routes } from '../../utils/routes';

const featuredPhoto = catPhotos.find((photo) => photo.featured) ?? catPhotos[0];
const caption = featuredPhoto?.caption ?? '오늘도 기록실 어딘가를 차지하고 있습니다.';
---

<section class="manyang-card" aria-labelledby="manyang-card-title">
  <div class="shell manyang-card__layout">
    {
      featuredPhoto && (
        <figure class="manyang-card__photo">
          <Image
            src={featuredPhoto.image}
            alt={featuredPhoto.alt}
            widths={[360, 520, 720, 960]}
            sizes="(max-width: 860px) 100vw, 480px"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="meta">{featuredPhoto.caption}</figcaption>
        </figure>
      )
    }
    <div class="manyang-card__content">
      <SectionHead
        kicker="04 / MANYANG & GUREUM"
        title="만냥구름 한 컷"
        titleId="manyang-card-title"
      />
      <p>
        {caption} 이불 위에서 쉬거나, 소파에 나란히 머물거나, 조용히 옆자리를 내어주는 순간들을 모아둡니다.
      </p>
      <TextLink href={routes.manyangGureum}>만냥구름 보러가기</TextLink>
    </div>
  </div>
</section>

<style>
  .manyang-card {
    padding: clamp(60px, 8vw, 110px) 0 clamp(110px, 14vw, 200px);
  }

  .manyang-card__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 75px);
    align-items: center;
  }

  .manyang-card__photo {
    margin: 0;
    padding-top: 25px;
    border-top: 1px solid var(--line);
  }

  .manyang-card__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .manyang-card__photo figcaption {
    margin-top: 1rem;
  }

  .manyang-card__content > p {
    max-width: 30rem;
    margin: 0 0 2rem;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  @media (max-width: 860px) {
    .manyang-card__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .manyang-card__content {
      order: -1;
    }
  }
</style>
