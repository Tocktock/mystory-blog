---
import { Image } from 'astro:assets';
import FormattedDate from '../FormattedDate.astro';
import TextLink from '../observatory/TextLink.astro';
import deepField from '../../assets/observatory/deep-field.png';
import { uiCopy } from '../../data/uiCopy';
import { routes } from '../../utils/routes';

interface Props {
  recordCount: number;
  seriesCount: number;
  latestRecordTitle: string;
  latestRecordHref?: string;
  latestRecordDate?: Date;
}

const { recordCount, seriesCount, latestRecordTitle, latestRecordHref, latestRecordDate } =
  Astro.props as Props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Image
    src={deepField}
    alt=""
    widths={[720, 1080, 1440, 1672]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="home-hero__image"
  />

  <div class="home-hero__layout">
    <div class="home-hero__copy">
      <p class="kicker">THE MIDNIGHT OBSERVATORY</p>
      <h1 id="home-hero-title">지용의 기록실</h1>
      <p class="home-hero__tagline">관찰하고, 실험하고, 이야기한다.</p>
      <p class="home-hero__description">
        문제를 관찰하고 구조를 세운 뒤, Backend와 AI Agent 실험을 작은 도구와 기록으로 남깁니다.
        만냥구름과 일상의 관찰도 같은 책상 위에 둡니다.
      </p>
      <nav class="home-hero__links" aria-label="홈 주요 이동">
        <TextLink href={routes.records}>기록 보기</TextLink>
        <TextLink href={routes.series}>시리즈 보기</TextLink>
        <TextLink href={routes.manyangGureum}>만냥구름 만나기</TextLink>
      </nav>
    </div>

    <aside class="home-hero__desk" aria-label={uiCopy.currentDesk}>
      <p class="home-hero__desk-title">{uiCopy.currentDesk}</p>
      <dl>
        <div class="home-hero__stat home-hero__stat--latest">
          <dt>{uiCopy.recentRecord}</dt>
          <dd>
            {
              latestRecordHref ? (
                <a href={latestRecordHref}>{latestRecordTitle}</a>
              ) : (
                <span>{latestRecordTitle}</span>
              )
            }
            {latestRecordDate && <FormattedDate class="home-hero__date" date={latestRecordDate} />}
          </dd>
        </div>
        <div class="home-hero__stat">
          <dt>{uiCopy.stackedRecords}</dt>
          <dd>{recordCount}편</dd>
        </div>
        <div class="home-hero__stat">
          <dt>{uiCopy.ongoingSeries}</dt>
          <dd>{seriesCount}개</dd>
        </div>
      </dl>
    </aside>
  </div>

  <p class="kicker home-hero__bottom" aria-hidden="true">
    A PERSONAL ARCHIVE OF SPACE, MATTER &amp; STORIES
  </p>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    min-height: max(100svh, 720px);
    margin-top: calc(-1 * var(--header-height));
    align-items: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  .home-hero :global(.home-hero__image) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .home-hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 2%, transparent) 0%,
      color-mix(in srgb, var(--bg) 12%, transparent) 55%,
      var(--bg) 99%
    );
    pointer-events: none;
  }

  .home-hero__layout {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 3rem;
    align-items: end;
    padding: 0 clamp(24px, 8vw, 135px) clamp(120px, 15vh, 185px);
  }

  .home-hero__copy {
    max-width: 760px;
  }

  .home-hero__copy h1 {
    margin: 28px 0 16px;
    font-size: clamp(2.6rem, 4.7vw, 4.5rem);
    letter-spacing: -0.055em;
  }

  .home-hero__tagline {
    margin: 0 0 1.25rem;
    color: var(--fg);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }

  .home-hero__description {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.95;
    word-break: keep-all;
  }

  .home-hero__links {
    display: flex;
    gap: 0.75rem 2rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }

  .home-hero__desk {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .home-hero__desk-title,
  .home-hero__desk dt {
    margin: 0;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.04em;
  }

  .home-hero__desk dl {
    margin: 0.75rem 0 0;
  }

  .home-hero__stat {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .home-hero__desk dd {
    margin: 0;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .home-hero__desk dd a {
    color: var(--fg);
    text-decoration: none;
  }

  .home-hero__desk dd a:hover {
    color: var(--accent);
  }

  .home-hero__desk :global(.home-hero__date) {
    display: block;
    margin-top: 0.25rem;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .home-hero__bottom {
    position: absolute;
    bottom: 35px;
    left: clamp(24px, 8vw, 135px);
    color: var(--dim);
    font-size: 0.58rem;
  }

  @media (max-width: 960px) {
    .home-hero__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .home-hero__desk {
      max-width: 420px;
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      min-height: max(100svh, 640px);
    }

    .home-hero :global(.home-hero__image) {
      object-position: 61% top;
    }

    .home-hero__layout {
      padding: 140px 24px 110px;
    }

    .home-hero__copy h1 {
      font-size: 2.6rem;
    }

    .home-hero__bottom {
      left: 24px;
      right: 24px;
      letter-spacing: 0.1em;
    }
  }
</style>
