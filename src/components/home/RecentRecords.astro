---
import type { CollectionEntry } from 'astro:content';
import EntryList from '../observatory/EntryList.astro';
import EntryRow from '../observatory/EntryRow.astro';
import SectionHead from '../observatory/SectionHead.astro';
import TextLink from '../observatory/TextLink.astro';
import { getCategory } from '../../data/categories';
import { getSeries } from '../../data/series';
import { routes } from '../../utils/routes';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props as Props;
---

<section class="recent-records" aria-labelledby="recent-records-title">
  <div class="shell">
    <SectionHead
      kicker="01 / RECENT OBSERVATIONS"
      title="최근 기록"
      titleId="recent-records-title"
    />
    {
      posts.length > 0 ? (
        <EntryList>
          {posts.map((post, index) => {
            const category = getCategory(post.data.category);
            const seriesEntry = getSeries(post.data.series);
            return (
              <EntryRow
                href={routes.record(post.id)}
                title={post.data.title}
                index={index + 1}
                date={post.data.pubDate}
              >
                <p slot="meta" class="meta recent-records__meta">
                  {category.label}
                  {seriesEntry && <span> · {seriesEntry.title}</span>}
                </p>
              </EntryRow>
            );
          })}
        </EntryList>
      ) : (
        <p class="recent-records__empty">
          아직 보여줄 기록이 없어요. 기록실 책장은 곧 채워질 예정입니다.
        </p>
      )
    }
    <TextLink class="recent-records__all" href={routes.records}>ALL RECORDS</TextLink>
  </div>
</section>

<style>
  .recent-records {
    padding: clamp(110px, 12vw, 165px) 0 clamp(90px, 10vw, 140px);
  }

  .recent-records__meta {
    margin: 0.35rem 0 0;
  }

  .recent-records__empty {
    padding: 3rem 0;
    color: var(--muted);
  }

  .recent-records :global(.recent-records__all) {
    margin-top: 38px;
  }
</style>
