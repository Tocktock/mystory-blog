---
import SectionHead from '../observatory/SectionHead.astro';
import { routes } from '../../utils/routes';

const shelves = [
  {
    title: 'AI & Agent 실험실',
    description:
      '도구를 직접 만들고 써보며, 어디까지 맡길 수 있고 어디부터 사람이 판단해야 하는지 남긴 기록입니다.',
    href: routes.series,
    label: '실험실 보기',
    kind: 'LAB',
    note: '실험, 판단, 다시 쓰는 기준을 한곳에 모읍니다.',
  },
  {
    title: 'Backend 설계 노트',
    description:
      '요구사항과 운영 흐름을 읽고, API와 데이터 구조를 어디에 세울지 정리한 기술 기록입니다.',
    href: routes.category('tech'),
    label: '설계 노트 보기',
    kind: 'NOTES',
    note: '구조를 먼저 읽고 작은 변경으로 확인합니다.',
  },
  {
    title: '문제를 다시 푸는 법',
    description:
      '처음 본 현상을 바로 결론내리지 않고, 원인과 선택지를 다시 분해해본 생각의 기록입니다.',
    href: routes.category('thought'),
    label: '생각 보기',
    kind: 'THOUGHT',
    note: '일하는 방식과 생활의 관찰을 같이 둡니다.',
  },
  {
    title: '만냥구름 관찰일지',
    description: '기록실 옆자리를 채우는 두 고양이의 표정과 습관을 조용히 모아둡니다.',
    href: routes.manyangGureum,
    label: '관찰일지 보기',
    kind: 'OBSERVATION',
    note: '돌봄과 관찰도 기록실의 한 층입니다.',
  },
];
---

<section class="bookshelf" aria-labelledby="bookshelf-title">
  <div class="shell">
    <SectionHead kicker="02 / SHELVES" title="기록실 책장" titleId="bookshelf-title">
      <p class="bookshelf__intro">
        Backend와 AI 실험, 문제를 다시 푸는 습관, 그리고 만냥구름의 관찰이 같은 기록실에서 서로를
        설명합니다.
      </p>
    </SectionHead>

    <div class="bookshelf__grid">
      {
        shelves.map((shelf, index) => (
          <a class="bookshelf__shelf" href={shelf.href}>
            <span class="kicker bookshelf__index">
              {String(index + 1).padStart(2, '0')} / {shelf.kind}
            </span>
            <h3>{shelf.title}</h3>
            <p>{shelf.description}</p>
            <p class="bookshelf__note">{shelf.note}</p>
            <span class="bookshelf__link">
              {shelf.label} <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bookshelf {
    padding: clamp(60px, 8vw, 110px) 0;
  }

  .bookshelf__intro {
    max-width: 640px;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.95;
    word-break: keep-all;
  }

  .bookshelf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 75px;
    border-top: 1px solid var(--line);
  }

  .bookshelf__shelf {
    display: block;
    padding: 42px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .bookshelf__index {
    color: var(--dim);
  }

  .bookshelf__shelf h3 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.5;
  }

  .bookshelf__shelf p {
    margin: 0;
    color: var(--muted);
    line-height: 1.9;
    word-break: keep-all;
  }

  .bookshelf__shelf .bookshelf__note {
    margin-top: 0.75rem;
    color: var(--dim);
    font-size: 0.85rem;
  }

  .bookshelf__link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
  }

  .bookshelf__shelf:hover h3,
  .bookshelf__shelf:hover .bookshelf__link {
    color: var(--fg-strong);
  }

  @media (max-width: 700px) {
    .bookshelf__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
