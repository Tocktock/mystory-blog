---
import SectionHead from '../observatory/SectionHead.astro';
import { routes } from '../../utils/routes';

const shelves = [
  {
    title: 'AI & Agent 실험실',
    description:
      'AI 도구를 직접 만들고 써 보면서, 어디까지 맡기고 어디부터 사람이 판단해야 하는지 적었어요.',
    href: routes.series,
    label: '실험실 보기',
    kind: 'AI',
  },
  {
    title: 'Backend 설계 노트',
    description: '요구사항을 보고 API와 데이터 구조를 어떻게 잡았는지 정리한 글이에요.',
    href: routes.category('tech'),
    label: '설계 노트 보기',
    kind: 'BACKEND',
  },
  {
    title: '문제를 다시 푸는 법',
    description: '막혔던 문제를 다시 들여다보면서 원인과 선택지를 하나씩 정리한 글이에요.',
    href: routes.category('thought'),
    label: '생각 보기',
    kind: 'THINKING',
  },
  {
    title: '만냥구름 관찰일지',
    description: '같이 사는 고양이 만냥이와 구름이를 돌보며 알게 된 것들이에요.',
    href: routes.manyangGureum,
    label: '관찰일지 보기',
    kind: 'CATS',
  },
];
---

<section class="bookshelf" aria-labelledby="bookshelf-title">
  <div class="shell">
    <SectionHead kicker="02 / TOPICS" title="주제별로 보기" titleId="bookshelf-title">
      <p class="bookshelf__intro">주로 이런 이야기를 써요.</p>
    </SectionHead>

    <div class="bookshelf__grid">
      {
        shelves.map((shelf, index) => (
          <a class="bookshelf__shelf" href={shelf.href}>
            <span class="kicker bookshelf__index">
              {String(index + 1).padStart(2, '0')} / {shelf.kind}
            </span>
            <h3>{shelf.title}</h3>
            <p>{shelf.description}</p>
            <span class="bookshelf__link">
              {shelf.label} <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bookshelf {
    padding: clamp(60px, 8vw, 110px) 0;
  }

  .bookshelf__intro {
    max-width: 640px;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.95;
    word-break: keep-all;
  }

  .bookshelf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 75px;
    border-top: 1px solid var(--line);
  }

  .bookshelf__shelf {
    display: block;
    padding: 42px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .bookshelf__index {
    color: var(--dim);
  }

  .bookshelf__shelf h3 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.5;
  }

  .bookshelf__shelf p {
    margin: 0;
    color: var(--muted);
    line-height: 1.9;
    word-break: keep-all;
  }

  .bookshelf__link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.14em;
  }

  .bookshelf__shelf:hover h3,
  .bookshelf__shelf:hover .bookshelf__link {
    color: var(--fg-strong);
  }

  @media (max-width: 700px) {
    .bookshelf__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
