---
import type { SeriesEntry } from '../../data/series';
import { getCategory } from '../../data/categories';
import { getSeriesStatusLabel } from '../../data/series';
import { routes } from '../../utils/routes';

interface Props {
  seriesItem: SeriesEntry;
  count: number;
  index?: number;
}

const { seriesItem, count, index } = Astro.props as Props;
const category = getCategory(seriesItem.category);
const statusLabel = getSeriesStatusLabel(seriesItem.status);
const number = typeof index === 'number' ? String(index).padStart(2, '0') : undefined;
const intentItems = [
  seriesItem.purpose?.trim()
    ? { label: '왜 이 선반인가', value: seriesItem.purpose.trim() }
    : undefined,
  seriesItem.readingPromise?.trim()
    ? { label: '읽고 나면', value: seriesItem.readingPromise.trim() }
    : undefined,
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<a
  class="series-card"
  href={routes.seriesDetail(seriesItem.slug)}
  data-series-status={seriesItem.status}
>
  <div class="meta series-card__meta" aria-label="시리즈 정보">
    {number && <span class="series-card__number">{number}</span>}
    <span>{category.label}</span>
    <span>{count}개 기록</span>
    {statusLabel && <span class="series-card__status">{statusLabel}</span>}
  </div>
  <h2>{seriesItem.title}</h2>
  <p class="series-card__description">{seriesItem.description}</p>
  {
    intentItems.length > 0 && (
      <dl class="series-card__intent" aria-label="시리즈 선반 안내">
        {intentItems.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <span class="series-card__link" aria-hidden="true">선반 열기 ↗</span>
</a>

<style>
  .series-card {
    display: block;
    height: 100%;
    padding: 42px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .series-card__meta {
    display: flex;
    flex-wrap: wrap;
  }

  .series-card__meta span + span::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .series-card__number {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  .series-card h2 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.5;
    transition: color var(--motion-fast) ease;
  }

  .series-card__description {
    margin: 0;
    color: var(--muted);
    line-height: 1.9;
    word-break: keep-all;
  }

  .series-card__intent {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .series-card__intent dt {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.04em;
  }

  .series-card__intent dd {
    margin: 0.35rem 0 0;
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  .series-card__link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    transition: color var(--motion-fast) ease;
  }

  .series-card:hover h2,
  .series-card:hover .series-card__link {
    color: var(--fg-strong);
  }
</style>
