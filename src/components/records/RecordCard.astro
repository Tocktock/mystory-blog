---
import type { CollectionEntry } from 'astro:content';
import EntryRow from '../observatory/EntryRow.astro';
import { getCategory } from '../../data/categories';
import { getRecordStatus, getRecordType } from '../../data/recordTypes';
import { getSeries } from '../../data/series';
import { routes } from '../../utils/routes';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  showCategory?: boolean;
  showTags?: boolean;
  headingLevel?: 2 | 3;
}

const {
  post,
  index,
  showCategory = true,
  showTags = true,
  headingLevel = 2,
} = Astro.props as Props;
const category = getCategory(post.data.category);
const seriesEntry = getSeries(post.data.series);
const recordType = getRecordType(post.data.recordType);
const statusLabel = getRecordStatus(post.data.status);
const intentItems = [
  post.data.problem?.trim() ? { label: '문제', value: post.data.problem.trim() } : undefined,
  post.data.lesson?.trim() ? { label: '배운 것', value: post.data.lesson.trim() } : undefined,
].filter((item): item is { label: string; value: string } => Boolean(item));
const metaItems = [
  showCategory ? { className: 'record-card__category', label: category.label } : undefined,
  recordType ? { className: 'record-card__type', label: recordType.label } : undefined,
  statusLabel ? { className: 'record-card__status', label: statusLabel } : undefined,
  seriesEntry ? { className: 'record-card__series', label: seriesEntry.title } : undefined,
].filter((item): item is { className: string; label: string } => Boolean(item));
---

<EntryRow
  class="record-card"
  href={routes.record(post.id)}
  title={post.data.title}
  index={index}
  date={post.data.pubDate}
  headingLevel={headingLevel}
  data-category={category.slug}
>
  {
    metaItems.length > 0 && (
      <p slot="meta" class="meta record-card__meta">
        {metaItems.map((item) => (
          <span class={item.className}>{item.label}</span>
        ))}
      </p>
    )
  }
  <p class="record-card__description">{post.data.description}</p>
  {
    intentItems.length > 0 && (
      <dl class="record-card__intent" aria-label="기록 의도">
        {intentItems.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    showTags && post.data.tags.length > 0 && (
      <ul class="record-card__tags" aria-label="기록 태그">
        {post.data.tags.map((tag) => (
          <li>#{tag}</li>
        ))}
      </ul>
    )
  }
</EntryRow>

<style>
  .record-card__meta {
    display: flex;
    gap: 0.25rem 0;
    flex-wrap: wrap;
    margin: 0.35rem 0 0;
  }

  .record-card__meta span + span::before {
    margin: 0 0.6em;
    color: var(--line-strong);
    content: '/';
  }

  .record-card__description {
    max-width: 46rem;
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  .record-card__intent {
    display: grid;
    max-width: 46rem;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--line);
  }

  .record-card__intent div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .record-card__intent dt {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .record-card__intent dd {
    margin: 0;
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .record-card__tags {
    display: flex;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
    margin: 0.75rem 0 0;
    padding: 0;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.04em;
    list-style: none;
  }
</style>
