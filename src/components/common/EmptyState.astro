---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { uiCopy } from '../../data/uiCopy';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  compact?: boolean;
}

const {
  eyebrow = uiCopy.emptyDrawer,
  title = uiCopy.emptyDrawerTitle,
  description = uiCopy.emptyDrawerDescription,
  href,
  linkLabel,
  image,
  imageAlt = '',
  compact = false,
} = Astro.props as Props;
const hasImage = Boolean(image);
---

<section
  class:list={[
    'empty-state',
    {
      'empty-state--compact': compact,
      'empty-state--with-image': hasImage,
    },
  ]}
  aria-label={title}
>
  <div class="empty-state__content">
    <p class="meta empty-state__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{description}</p>
    {
      href && linkLabel && (
        <a href={href}>
          {linkLabel}
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>

  {
    image && (
      <div class="empty-state__image-frame">
        <Image
          src={image}
          alt={imageAlt}
          widths={[320, 480, 640, 960]}
          sizes="(max-width: 720px) 100vw, 360px"
          loading="lazy"
          decoding="async"
          class="empty-state__image"
        />
      </div>
    )
  }
</section>

<style>
  /* A ruled drawer, not a card: matches the Observatory features. */
  .empty-state {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 42px 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .empty-state--with-image {
    grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
  }

  .empty-state--compact {
    padding: 32px 0;
  }

  .empty-state__eyebrow {
    margin: 0;
  }

  .empty-state h2 {
    margin: 0.75rem 0;
    color: var(--fg);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.5;
  }

  .empty-state p:not(.empty-state__eyebrow) {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.95;
    word-break: keep-all;
  }

  .empty-state a {
    display: inline-flex;
    gap: 0.6em;
    align-items: baseline;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .empty-state a:hover {
    color: var(--fg);
  }

  .empty-state__image-frame {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .empty-state__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .empty-state--with-image {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
