---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostMeta from '../components/records/PostMeta.astro';
import RecordSummary from '../components/records/RecordSummary.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { getCategory } from '../data/categories';
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';
import { routes } from '../utils/routes';
import { serializeJsonLd } from '../utils/serializeJsonLd';

type Props = CollectionEntry<'blog'>['data'] & {
  lang?: string;
  slug: string;
  ogImage?: string;
  sectionName?: string;
  sectionPath?: string;
  sectionKicker?: string;
  showPostMeta?: boolean;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt: providedHeroImageAlt,
  lang: providedLang,
  slug,
  ogImage,
  category,
  tags = [],
  series: seriesSlug,
  recordType,
  status,
  problem,
  lesson,
  sectionName = '기록',
  sectionPath = '/records',
  sectionKicker,
  showPostMeta: providedShowPostMeta,
} = Astro.props as Props;
const lang = providedLang === 'en' ? 'en' : 'ko';
const isRecordPost = sectionPath === '/records';
const showPostMeta = providedShowPostMeta ?? isRecordPost;
const categoryEntry = getCategory(category);
const showHero = isRecordPost && Boolean(heroImage);
const heroImageAlt = heroImage ? (providedHeroImageAlt ?? `${title} 대표 이미지`) : '';
const heroBaseWidth = heroImage ? Math.min(1000, heroImage.width) : 1000;
const heroWidths = heroImage
  ? [360, 480, 720, 1000, 1280].filter((width) => width <= heroImage.width)
  : [];

const siteURL = Astro.site ? new URL(Astro.site) : Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();
const heroImageURL = heroImage ? new URL(heroImage.src, siteURL).toString() : undefined;
const ogImagePath = ogImage ?? (slug ? `/og/${slug}.png` : undefined);
const ogImageURL = ogImagePath ? new URL(ogImagePath, siteURL).toString() : heroImageURL;
const publishedISO =
  pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate).toISOString();
const updatedISO = updatedDate
  ? updatedDate instanceof Date
    ? updatedDate.toISOString()
    : new Date(updatedDate).toISOString()
  : publishedISO;
const imageCandidates = [ogImageURL, heroImageURL].filter(
  (value): value is string => typeof value === 'string',
);
const jsonLdImages = Array.from(new Set(imageCandidates));
const breadcrumbItems = [
  { position: 1, name: SITE_TITLE, item: siteURL.toString() },
  { position: 2, name: sectionName, item: new URL(sectionPath, siteURL).toString() },
  { position: 3, name: title, item: canonicalURL },
];
const articleJsonLd = buildArticleJsonLd({
  canonicalUrl: canonicalURL,
  title,
  description,
  lang,
  datePublished: publishedISO,
  dateModified: updatedISO,
  author: SITE_AUTHOR,
  imageUrls: jsonLdImages,
});
const breadcrumbJsonLd = buildBreadcrumbJsonLd({
  items: breadcrumbItems,
});
---

<SiteLayout
  title={title}
  description={description}
  image={ogImageURL}
  lang={lang}
  mainLabelledBy="article-title"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(articleJsonLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(breadcrumbJsonLd)}
  />

  <article class="article">
    <header class="article__header">
      {
        isRecordPost ? (
          <p class="meta article__breadcrumb">
            <a href={routes.records}>RECORDS</a>
            <span aria-hidden="true">/</span>
            <a href={routes.category(categoryEntry.slug)}>{categoryEntry.label}</a>
          </p>
        ) : (
          sectionKicker && <p class="kicker">{sectionKicker}</p>
        )
      }
      <h1 id="article-title" class="article__title">{title}</h1>
      {
        isRecordPost && (
          <p class="meta article__dates">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="article__updated">
                UPDATED <FormattedDate date={updatedDate} />
              </span>
            )}
          </p>
        )
      }
      {showPostMeta && <PostMeta category={category} tags={tags} seriesSlug={seriesSlug} />}
      {
        isRecordPost && (
          <RecordSummary
            recordType={recordType}
            status={status}
            problem={problem}
            lesson={lesson}
          />
        )
      }
    </header>

    {
      showHero && heroImage && (
        <figure class="hero-image">
          <Image
            src={heroImage}
            alt={heroImageAlt}
            width={heroBaseWidth}
            widths={heroWidths}
            sizes="(max-width: 1048px) calc(100vw - 48px), 1000px"
            class="hero-image__media"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="post-content">
      <slot />
    </div>
  </article>
</SiteLayout>

<style>
  .article {
    padding: 0 24px clamp(120px, 14vw, 180px);
  }

  .article__header,
  .post-content {
    max-width: var(--reading);
    margin: 0 auto;
  }

  .article__header {
    padding: clamp(85px, 12vw, 118px) 0 clamp(48px, 6vw, 70px);
    border-bottom: 1px solid var(--line);
  }

  .article__breadcrumb {
    display: flex;
    gap: 0.6em;
    margin: 0;
  }

  .article__breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .article__breadcrumb a:first-child {
    letter-spacing: 0.14em;
  }

  .article__breadcrumb a:hover {
    color: var(--fg);
  }

  .article__title {
    margin: 35px 0;
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    line-height: 1.5;
    letter-spacing: -0.04em;
  }

  .article__dates {
    display: flex;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .hero-image {
    max-width: 1000px;
    margin: clamp(40px, 6vw, 64px) auto 0;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .hero-image :global(.hero-image__media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    padding-top: clamp(48px, 6vw, 60px);
    color: var(--text);
  }

  /* Rendered Markdown */
  .post-content :global(.article-body) {
    font-size: 17px;
    line-height: 2.1;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .post-content :global(.article-body > :first-child) {
    margin-top: 0;
  }

  .post-content :global(.article-body p) {
    margin: 0 0 1.75em;
  }

  .post-content :global(.article-body h1),
  .post-content :global(.article-body h2),
  .post-content :global(.article-body h3),
  .post-content :global(.article-body h4) {
    color: var(--fg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .post-content :global(.article-body h1) {
    margin: 4rem 0 1.25rem;
    font-size: clamp(1.75rem, 3.4vw, 2.3rem);
    line-height: 1.45;
  }

  .post-content :global(.article-body h2) {
    margin: 5rem 0 1.4rem;
    padding-top: 2.2rem;
    border-top: 1px solid var(--line);
    font-size: 1.56rem;
    line-height: 1.55;
  }

  .post-content :global(.article-body section h2),
  .post-content :global(.article-body blockquote h2) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .post-content :global(.article-body h3) {
    margin: 3.25rem 0 1rem;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .post-content :global(.article-body h4) {
    margin: 2.5rem 0 0.85rem;
    font-size: 1.06rem;
  }

  .post-content :global(.article-body a) {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .post-content :global(.article-body a:hover) {
    color: var(--fg-strong);
    text-decoration-color: currentColor;
  }

  .post-content :global(.article-body ul),
  .post-content :global(.article-body ol) {
    margin: 0 0 1.75em;
    padding-left: 1.35rem;
  }

  .post-content :global(.article-body li + li) {
    margin-top: 0.4rem;
  }

  .post-content :global(.article-body li::marker) {
    color: var(--dim);
  }

  .post-content :global(.article-body hr) {
    margin: 3.5rem 0;
  }

  .post-content :global(.article-body blockquote) {
    margin: 2.8rem 0;
    padding: 0 0 0 1.75rem;
    border-left: 1px solid var(--rule-accent);
    color: var(--muted);
  }

  .post-content :global(.article-body blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-content :global(.article-body :not(pre) > code) {
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .post-content :global(.article-body pre) {
    margin: 2rem 0 2.5rem;
    overflow-x: auto;
    word-break: normal;
  }

  .post-content :global(.article-body img) {
    display: block;
    margin: 2.5rem auto;
    border: 1px solid var(--line);
  }

  .post-content :global(.article-body .wide-image-frame) {
    display: flex;
    width: 100%;
    margin: 2.5rem auto;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .post-content :global(.article-body .wide-image-frame img) {
    width: auto;
    max-width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    object-fit: contain;
  }

  .post-content :global(.article-body table) {
    display: block;
    width: 100%;
    margin: 2.25rem 0;
    font-size: 0.92rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .post-content :global(.article-body th),
  .post-content :global(.article-body td) {
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .post-content :global(.article-body th) {
    border-bottom-color: var(--line-strong);
    color: var(--fg);
    font-weight: 600;
  }

  .post-content :global(.article-body th:first-child),
  .post-content :global(.article-body td:first-child) {
    min-width: 4.25rem;
    white-space: nowrap;
  }

  .post-content :global(.article-body .callout) {
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-left-color: var(--rule-accent);
    background: var(--bg-raised);
  }

  .post-content :global(.article-body > section) {
    margin: 0;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--line);
  }

  .post-content :global(.article-body > section:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .post-content :global(.article-body > section > :last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .article__title {
      font-size: 2.1rem;
    }

    .post-content :global(.article-body) {
      font-size: 16px;
      line-height: 2;
    }

    .post-content :global(.article-body h2) {
      margin-top: 3.75rem;
      padding-top: 1.8rem;
    }

    .post-content :global(.article-body .callout) {
      padding: 1.2rem 1.25rem;
    }
  }
</style>
