---
import SiteLayout from './SiteLayout.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { buildBreadcrumbJsonLd, buildPersonJsonLd } from '../utils/jsonld';
import { routes } from '../utils/routes';
import { serializeJsonLd } from '../utils/serializeJsonLd';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props as Props;
const siteURL = Astro.site ? new URL(Astro.site) : Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();
const personJsonLd = buildPersonJsonLd({
  canonicalUrl: canonicalURL,
  name: SITE_AUTHOR,
  description,
});
const breadcrumbJsonLd = buildBreadcrumbJsonLd({
  items: [
    { position: 1, name: SITE_TITLE, item: siteURL.toString() },
    { position: 2, name: '이력', item: new URL(routes.career, siteURL).toString() },
  ],
});
---

<SiteLayout title={title} description={description} lang="ko" mainLabelledBy="career-title">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(personJsonLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(breadcrumbJsonLd)}
  />
  <div class="career-page">
    <slot />
  </div>
</SiteLayout>

<style>
  .career-page {
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  /* Shared career rhythm: numbered sections built from prototype career-lines. */
  :global(.career-section) {
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(90px, 11vw, 150px) var(--gutter) 0;
    scroll-margin-top: 1.5rem;
  }

  :global(.career-section--compact) {
    padding-top: clamp(64px, 8vw, 100px);
  }

  :global(.career-line) {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 40px;
    padding: 38px 0;
    border-top: 1px solid var(--line);
  }

  :global(.career-line:last-child) {
    border-bottom: 1px solid var(--line);
  }

  :global(.career-line h3) {
    margin: 0;
    color: var(--fg);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.55;
  }

  :global(.career-line p) {
    color: var(--muted);
    line-height: 1.9;
    word-break: keep-all;
  }

  :global(.career-list) {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.career-list li) {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.85;
    word-break: keep-all;
  }

  :global(.career-list li + li) {
    margin-top: 0.4rem;
  }

  :global(.career-list li::before) {
    position: absolute;
    left: 0;
    color: var(--dim);
    content: '—';
  }

  :global(.career-facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem 2rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  :global(.career-facts dt) {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.04em;
  }

  :global(.career-facts dd) {
    margin: 0.3rem 0 0;
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.75;
    word-break: keep-all;
  }

  :global(.career-link) {
    display: inline-flex;
    gap: 0.6em;
    align-items: baseline;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  :global(.career-link:hover) {
    color: var(--fg);
  }

  @media (max-width: 700px) {
    :global(.career-line) {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding: 28px 0;
    }
  }
</style>
