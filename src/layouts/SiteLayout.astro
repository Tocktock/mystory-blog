---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'ko' | 'en';
  bodyClass?: string;
  mainLabelledBy?: string;
}

const { title, description, image, lang = 'ko', bodyClass, mainLabelledBy } = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} lang={lang} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main" tabindex="-1" aria-labelledby={mainLabelledBy}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
